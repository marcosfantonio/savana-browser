using Gtk 4.0;
using Adw 1;

menu move_menu {
  section {
    item {
      label: _("Move Up");
      action: "row.move-up";
    }

    item {
      label: _("Move Down");
      action: "row.move-down";
    }
  }
}

template $EphyBookmarkRow: Adw.ActionRow {
  title-lines: 1;
  subtitle-lines: 2;
  use-markup: false;
  activatable: true;

  styles ["savana-bookmark-row"]

  child: Box {
    spacing: 10;
    margin-top: 10;
    margin-bottom: 10;

    Image drag_handle {
      icon-name: "list-drag-handle-symbolic";

      DragSource {
        actions: move;
        prepare => $drag_prepare_cb() swapped;
        drag-begin => $drag_begin_cb() swapped;
      }
    }

    Image favicon_image {
      pixel-size: 48;
      valign: start;
    }

    Box {
      orientation: vertical;
      spacing: 4;
      hexpand: true;

      Label title_label {
        label: bind template.title;
        xalign: 0;
        ellipsize: end;
        styles ["heading"]
      }

      Box {
        spacing: 4;

        Image url_favicon_image {
          pixel-size: 16;
        }

        Label url_label {
          xalign: 0;
          ellipsize: end;
          hexpand: true;
          styles ["caption"]
        }
      }

      Label description_label {
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;
        lines: 2;
        ellipsize: end;
        styles ["dim-label", "caption"]
      }
    }

    Box edit_controls {
      valign: center;

      Button remove_button {
        icon-name: "user-trash-symbolic";
        receives-default: false;
        tooltip-text: _("Remove");
        valign: center;

        styles ["flat"]
      }

      Button properties_button {
        icon-name: "document-edit-symbolic";
        receives-default: false;
        valign: center;

        styles ["flat"]
      }

      MenuButton move_menu_button {
        icon-name: "view-more-symbolic";
        receives-default: false;
        tooltip-text: _("Move Controls");
        valign: center;
        menu-model: move_menu;

        styles ["flat"]
      }
    }
  };
}
