using Gtk 4.0;
using Adw 1;

template $EphyBookmarksDialog: Adw.Bin {
  Adw.ToolbarView toolbar_view {
    bottom-bar-style: raised;

    [top]
    Box bookmarks_header {
      spacing: 8;
      margin-start: 12;
      margin-end: 12;
      margin-top: 8;
      margin-bottom: 8;

      styles ["savanna-bookmarks-header"]

      Button back_button {
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Back");
        clicked => $on_close_button_clicked();
        styles ["flat", "circular"]
      }

      Label {
        label: _("Bookmarks");
        xalign: 0;
        hexpand: true;
        styles ["heading"]
      }

      Button done_button {
        visible: false;
        label: _("Done");
        clicked => $on_done_button_clicked();
        styles ["flat"]
      }

      MenuButton options_menu_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Options");
        menu-model: options_menu;
        styles ["flat", "circular"]
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Box {
        orientation: vertical;
        spacing: 12;
        margin-start: 12;
        margin-end: 12;
        margin-top: 12;
        margin-bottom: 12;

        Box {
          valign: start;
          orientation: vertical;
          spacing: 8;
          vexpand: true;

          SearchEntry search_entry {
            placeholder-text: _("Search bookmarks");
            search-changed => $on_search_entry_changed();

            EventControllerKey {
              key-pressed => $on_search_entry_key_pressed();
            }
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            styles [
              "undershoot-top",
            ]

            child: Stack toplevel_stack {
              vhomogeneous: false;
              interpolate-size: true;
              hexpand: true;
              margin-start: 2;
              margin-end: 2;
              margin-top: 2;
              margin-bottom: 2;

              StackPage {
                name: "default";

                child: ListBox bookmarks_list_box {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                };
              }

              StackPage {
                name: "searching_bookmarks";

                child: ListBox searching_bookmarks_list_box {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                };
              }

              StackPage {
                name: "tag_detail";

                child: Box {
                  orientation: vertical;
                  spacing: 6;

                  CenterBox {
                    start-widget: Button tag_detail_back_button {
                      action-name: "dialog.tag-detail-back";
                      icon-name: "go-previous-symbolic";
                      margin-start: 6;
                      margin-end: 6;

                      styles [
                        "flat",
                      ]
                    };

                    center-widget: Label tag_detail_label {
                      styles [
                        "heading",
                      ]

                      ellipsize: end;
                      max-width-chars: 0;
                      hexpand: true;
                    };
                  }

                  ListBox tag_detail_list_box {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]
                  }
                };
              }

              StackPage {
                name: "empty-state";

                child: Adw.StatusPage {
                  icon-name: "ephy-starred-symbolic";
                  title: _("No Bookmarks");
                  description: _("Bookmarked pages will appear here");

                  styles [
                    "compact",
                    "dim-label",
                  ]
                };
              }
            };
          }
        }
      };
    };
  }
}

menu options_menu {
  section {
    item {
      label: _("Edit");
      action: "dialog.edit";
    }
  }

  section {
    item {
      label: _("I_mport…");
      action: "app.import-bookmarks";
    }

    item {
      label: _("E_xport…");
      action: "app.export-bookmarks";
    }
  }
}
